<!DOCTYPE html>
<html>
  <head>
    <title>Hello, World!</title>
    <style>
        .face{
            border:2px solid black;
            height: 300px;
            width: 300px;
            border-radius: 50%;
            background-color:lightyellow;
            position: relative;
        }
        .eye1{
            height: 70px;
            width:50px;
            border:1px solid black;
            background-color: black;
            border-radius: 50%;
            position:absolute;
            left:60px;
            top:65px;
        }
        .eye2{
            height: 70px;
            width:50px;
            border:1px solid black;
            background-color: black;
            border-radius: 50%;
            position: absolute;
            left:180px;
            top:65px;
        }
        .smile{
            border-bottom:2px solid black;
            height: 100px;
            width: 200px;
        
            position:absolute;
            left:50px;
            top:140px;
            transition:border-radius 2s ;
        }
        .smile:hover{
            border-radius:50%;
        }
    </style>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
      <div class="face">
          <div class="eye1"></div>
          <div class="eye2"></div>
          <div class="smile"></div>
      </div>
  </body>
</html>